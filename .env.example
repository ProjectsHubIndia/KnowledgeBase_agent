# --- OpenAI (invoice extraction + query agent) ---
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# --- Database (Postgres — conversation sessions only) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:9432/agentvector

# --- Storage ---
INVOICE_DIR=invoice_data

# --- Bootstrap admin (seeded into the users table on FIRST startup only) ---
# After that, manage accounts from the admin console at /admin.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# --- Auth tokens ---
# Signs the login JWTs. Set this to any long random string; if you leave it
# unset a new one is generated on each boot, which signs everyone out on
# restart. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
