# Rename this file to .env and fill in your key.

# OpenAI key used for invoice extraction + the chat agent.
# IMPORTANT: set a hard monthly spend cap on this key in the OpenAI dashboard.
LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Login for the app. The first time the app starts, this becomes the
# ADMIN account — the one that can create agents and add more users.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Keeps you signed in across restarts. Any long random string works;
# if you leave it blank everyone has to sign in again after a restart.
JWT_SECRET=

# Optional overrides (defaults are fine):
# LLM_MODEL=gpt-4o-mini
# BULK_CONCURRENCY=8
